# @defaultRequired=true
# @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @sensitive @type=url
E2E_DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# @type=url
E2E_STORAGE_ENDPOINT=http://localhost:9000

# @sensitive
E2E_STORAGE_ACCESS_KEY_ID=dev-rustfs-access-key

# @sensitive
E2E_STORAGE_SECRET_ACCESS_KEY=password

E2E_KUBE_CONTEXT=k3d-quilt-dev

E2E_IMAGE=nginx:1.27-alpine

# @type=number(min=50)
E2E_RECONCILE_INTERVAL_MS=250

# @type=boolean
E2E_KEEP_RESOURCES=false
