{
    "name": "web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "tsc -b ../../packages/api && vite build",
        "serve": "vite preview",
        "start": "vite",
        "check-types": "tsc -b ../../packages/api && vite build && tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:browser": "playwright test",
        "test:browser:ui": "playwright test --ui",
        "test:storybook": "vitest run --config vitest.storybook.config.ts",
        "env:generate": "varlock codegen",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@better-auth/api-key": "1.7.21",
        "@orpc/client": "^1.16.2",
        "@orpc/tanstack-query": "^1.16.2",
        "@quilt/api": "workspace:*",
        "@quilt/auth": "workspace:*",
        "@quilt/ui": "workspace:*",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.107.1",
        "@tanstack/react-router": "^1.170.46",
        "@varlock/vite-integration": "1.5.5",
        "better-auth": "1.7.21",
        "lucide-react": "^1.72.0",
        "motion": "^14.12.0",
        "next-themes": "^0.4.6",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "sonner": "^2.0.8",
        "varlock": "1.24.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.65.0",
        "@quilt/config": "workspace:*",
        "@storybook/addon-a11y": "^10.6.7",
        "@storybook/addon-docs": "^10.6.7",
        "@storybook/addon-vitest": "^10.6.7",
        "@storybook/react-vite": "^10.6.7",
        "@tanstack/react-query-devtools": "^5.107.1",
        "@tanstack/react-router-devtools": "^1.167.3",
        "@tanstack/router-plugin": "^1.169.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.9",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/browser-playwright": "^5.1.0",
        "@vitest/coverage-v8": "^5.1.0",
        "jsdom": "^30.1.3",
        "storybook": "^10.6.7",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
