{
    "name": "quilt",
    "private": true,
    "license": "Apache-2.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "check-types": "turbo run check-types",
        "test": "turbo run test",
        "test:integration": "turbo run test:integration",
        "test:browser": "turbo run test:browser",
        "test:e2e": "turbo run test:e2e",
        "test:e2e:api": "turbo run test:e2e -F e2e",
        "release": "nx release --skip-publish",
        "release:dry": "nx release --skip-publish --dry-run",
        "dev:web": "turbo run dev -F web --",
        "dev:server": "turbo run dev -F server --",
        "dev:controller": "turbo run dev -F controller --",
        "quilt": "npm run quilt -w cli --",
        "db:push": "turbo run db:push -F @quilt/db --",
        "db:studio": "turbo run db:studio -F @quilt/db --",
        "db:generate": "turbo run db:generate -F @quilt/db --",
        "db:migrate": "turbo run db:migrate -F @quilt/db --",
        "infra:start": "docker compose -f dev/compose.yaml up -d",
        "infra:watch": "docker compose -f dev/compose.yaml up",
        "infra:stop": "docker compose -f dev/compose.yaml stop",
        "infra:down": "docker compose -f dev/compose.yaml down",
        "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/ && varlock codegen --path ./apps/controller/ && varlock codegen --path ./apps/e2e/ && varlock codegen --path ./packages/api/ && varlock codegen --path ./packages/storage/",
        "postinstall": "npm run env:generate",
        "auth:generate": "cd apps/server && npm run auth:generate",
        "check": "biome check --write .",
        "prepare": "husky"
    },
    "dependencies": {
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@nx/js": "^23.3.0",
        "@quilt/config": "*",
        "@tanstack/intent": "^0.5.5",
        "@types/node": "^26.4.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "nx": "^23.3.0",
        "turbo": "^2.11.7",
        "typescript": "^6.0.3",
        "varlock": "1.23.0"
    },
    "packageManager": "npm@11.16.0",
    "allowScripts": {
        "esbuild": true
    },
    "overrides": {
        "nx": {
            "undici": "^7.29.1"
        }
    },
    "intent": {
        "skills": [
            "drizzle-kit",
            "varlock",
            "@tanstack/router-core",
            "@tanstack/router-plugin",
            "@tanstack/virtual-file-routes"
        ]
    }
}
