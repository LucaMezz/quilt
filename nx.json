{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "analytics": false,
    "neverConnectToCloud": true,
    "release": {
        "groups": {
            "platform": {
                "projects": [
                    "server",
                    "web",
                    "@quilt/api",
                    "@quilt/auth",
                    "@quilt/db",
                    "@quilt/cluster",
                    "@quilt/ui"
                ],
                "projectsRelationship": "fixed",
                "releaseTag": {
                    "pattern": "v{version}"
                },
                "changelog": {
                    "file": "{projectRoot}/CHANGELOG.md",
                    "createRelease": false,
                    "renderer": "{workspaceRoot}/tools/release/changelog-renderer.cjs"
                }
            },
            "cli": {
                "projects": ["cli"],
                "projectsRelationship": "independent",
                "releaseTag": {
                    "pattern": "cli@{version}"
                },
                "changelog": {
                    "file": "{projectRoot}/CHANGELOG.md",
                    "createRelease": false
                }
            },
            "docs": {
                "projects": ["docs"],
                "projectsRelationship": "independent",
                "releaseTag": {
                    "pattern": "docs@{version}"
                },
                "changelog": {
                    "file": "{projectRoot}/CHANGELOG.md",
                    "createRelease": false
                }
            }
        },
        "version": {
            "specifierSource": "conventional-commits",
            "currentVersionResolver": "git-tag",
            "fallbackCurrentVersionResolver": "disk",
            "updateDependents": "never",
            "logUnchangedProjects": false
        },
        "conventionalCommits": {
            "types": {
                "docs": {
                    "semverBump": "patch",
                    "changelog": {
                        "title": "Documentation"
                    }
                },
                "revert": {
                    "semverBump": "patch",
                    "changelog": {
                        "title": "Reverts"
                    }
                }
            }
        },
        "git": {
            "commit": true,
            "commitMessage": "chore(release): publish {version}",
            "tag": true
        }
    }
}
