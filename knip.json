{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignore": [".claude/**"],
    "workspaces": {
        ".": {
            "entry": ["tools/release/changelog-renderer.cjs"],
            "ignoreDependencies": ["@nx/js", "@tanstack/intent"]
