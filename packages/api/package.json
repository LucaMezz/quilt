{
    "name": "@quilt/api",
    "version": "0.0.0",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./caller": "./src/caller.ts",
        "./context": "./src/context.ts",
        "./openapi": "./src/openapi.ts",
        "./router": "./src/routers/index.ts"
    },
    "imports": {
        "#/*": "./src/*.ts"
    },
    "scripts": {
        "build": "tsc -b",
        "check-types": "tsc -b",
        "generate:openapi": "tsx scripts/generate-openapi.ts",
        "test": "vitest run --project unit",
        "test:watch": "vitest --project unit",
        "test:integration": "vitest run --project integration --coverage.reportsDirectory=coverage/integration",
        "test:fuzz": "schemathesis run openapi.json"
    },
    "dependencies": {
        "@orpc/openapi": "^1.16.1",
        "@orpc/server": "^1.16.1",
        "@orpc/zod": "^1.16.1",
        "@quilt/auth": "workspace:*",
        "@quilt/db": "workspace:*",
        "@quilt/storage": "workspace:*",
        "drizzle-orm": "1.0.0-rc.5",
        "sharp": "^0.35.5",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@quilt/config": "workspace:*",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.0.5",
        "fast-check": "^4.10.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "varlock": "1.23.0",
        "vitest": "^5.0.5"
    }
}
