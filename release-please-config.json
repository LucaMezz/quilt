{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "release-type": "node",
    "changelog-sections": [
        {
            "type": "feat",
            "section": "Features"
        },
        {
            "type": "fix",
            "section": "Bug Fixes"
        },
        {
            "type": "perf",
            "section": "Performance Improvements"
        },
        {
            "type": "revert",
            "section": "Reverts"
        },
        {
            "type": "docs",
            "section": "Documentation"
        },
        {
            "type": "chore",
            "section": "Miscellaneous Chores",
            "hidden": true
        },
        {
            "type": "style",
            "section": "Styles",
            "hidden": true
        },
        {
            "type": "refactor",
            "section": "Code Refactoring",
            "hidden": true
        },
        {
            "type": "test",
            "section": "Tests",
            "hidden": true
        },
        {
            "type": "build",
            "section": "Build System",
            "hidden": true
        },
        {
            "type": "ci",
            "section": "Continuous Integration",
            "hidden": true
        }
    ],
    "packages": {
        ".": {
            "component": "platform",
            "include-component-in-tag": false,
            "initial-version": "0.1.0",
            "exclude-paths": [
                "apps/cli",
                "apps/docs",
                "apps/controller",
                "apps/e2e",
                "packages/config",
                "packages/storage",
                "package-lock.json",
                "pnpm-lock.yaml"
            ],
            "extra-files": [
                {
                    "type": "json",
                    "path": "apps/server/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "apps/web/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "packages/api/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "packages/auth/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "packages/db/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "packages/cluster/package.json",
                    "jsonpath": "$.version"
                },
                {
                    "type": "json",
                    "path": "packages/ui/package.json",
                    "jsonpath": "$.version"
                }
            ]
        },
        "apps/cli": {
            "component": "cli",
            "include-v-in-tag": false,
            "tag-separator": "@",
            "initial-version": "0.1.0"
        },
        "apps/docs": {
            "component": "docs",
            "include-v-in-tag": false,
            "tag-separator": "@"
        }
    }
}
