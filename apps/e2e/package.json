{
    "name": "e2e",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "check-types": "tsc -b ../../packages/api ../../packages/cluster && tsc --noEmit",
        "test:e2e": "vitest run",
        "test:e2e:watch": "vitest",
        "env:generate": "varlock codegen"
    },
    "dependencies": {
        "@kubernetes/client-node": "^2.0.0",
        "@orpc/client": "^1.15.7",
        "@orpc/server": "^1.15.7",
        "@quilt/api": "workspace:*",
        "@quilt/auth": "workspace:*",
        "@quilt/cluster": "workspace:*",
        "@quilt/db": "workspace:*",
        "@quilt/storage": "workspace:*",
        "controller": "workspace:*",
        "drizzle-orm": "1.0.0-rc.5",
        "pg": "^8.23.0",
        "server": "workspace:*",
        "varlock": "1.23.0"
    },
    "devDependencies": {
        "@quilt/config": "workspace:*",
        "@types/node": "^26.4.1",
        "@types/pg": "^8.23.1",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}
