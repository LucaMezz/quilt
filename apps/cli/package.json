{
    "name": "cli",
    "version": "0.0.0",
    "private": true,
    "license": "Apache-2.0",
    "type": "module",
    "exports": {
        "./main": "./src/main.ts",
        "./command-tree": "./src/command-tree.ts"
    },
    "bin": {
        "quilt": "./dist/index.mjs"
    },
    "scripts": {
        "build": "tsc -b ../../packages/api && tsdown",
        "check-types": "tsc -b ../../packages/api && tsc --noEmit",
        "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile build/quilt",
        "quilt": "tsx src/index.ts",
        "start": "node dist/index.mjs"
    },
    "devDependencies": {
        "@quilt/config": "*",
        "@types/node": "^26.6.5",
        "tsdown": "^0.23.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@orpc/client": "^1.15.7",
        "@quilt/api": "*",
        "chalk": "^6.0.1",
        "citty": "^0.2.2"
    }
}
