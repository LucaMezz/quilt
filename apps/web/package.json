        "@tanstack/react-router": "^1.170.44",
        "@varlock/vite-integration": "1.5.4",
        "better-auth": "1.7.10",
        "lucide-react": "^1.56.0",
        "next-themes": "^0.4.6",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "sonner": "^2.0.8",
