{
    "name": "cli",
    "version": "0.0.0",
    "private": true,
    "license": "Apache-2.0",
    "type": "module",
    "exports": {
        "./main": "./src/main.ts",
        "./command-tree": "./src/command-tree.ts"
    },
    "bin": {
        "quilt": "./dist/index.mjs"
    },
    "scripts": {
        "build": "tsc -b ../../packages/api && tsdown",
        "check-types": "tsc -b ../../packages/api && tsc --noEmit",
        "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile build/quilt",
        "quilt": "tsx src/index.ts",
        "start": "node dist/index.mjs",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@quilt/config": "workspace:*",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.0.5",
        "tsdown": "^0.23.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@better-auth/api-key": "1.7.14",
        "@commander-js/extra-typings": "15.0.0",
        "@inquirer/prompts": "8.7.5",
        "@napi-rs/keyring": "^2.1.2",
        "@orpc/client": "^1.16.1",
        "@quilt/api": "workspace:*",
        "@quilt/auth": "workspace:*",
        "better-auth": "1.7.14",
        "chalk": "^6.0.1",
        "cli-table3": "^0.6.5",
        "commander": "15.0.0",
        "log-symbols": "^7.0.1",
        "ora": "^9.4.1"
    }
}
