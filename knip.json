{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignore": [".claude/**"],
    "ignoreIssues": {
        "apps/e2e/src/harness/environment.ts": ["types"]
    },
    "workspaces": {
        ".": {
            "entry": ["tools/release/changelog-renderer.cjs"],
            "ignoreDependencies": ["@nx/js", "@tanstack/intent"]
        },
        "apps/controller": {
            "ignoreDependencies": ["drizzle-orm"]
        },
        "apps/web": {
            "entry": ["src/routes/**/*.tsx", ".storybook/vite.config.ts"],
            "ignoreUnresolved": ["./routeTree.gen", "@/routeTree.gen"]
        }
    }
}
