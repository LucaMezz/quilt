{
    "name": "server",
    "version": "0.0.0",
    "type": "module",
    "main": "src/index.ts",
    "exports": {
        "./app": "./src/app.ts"
    },
    "scripts": {
        "build": "tsc -b ../../packages/api && tsdown",
        "check-types": "tsc -b ../../packages/api && tsc --noEmit",
        "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.mjs",
        "env:generate": "varlock codegen",
        "auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
    },
    "dependencies": {
        "@orpc/openapi": "^1.16.0",
        "@orpc/server": "^1.16.0",
        "@orpc/zod": "^1.16.0",
        "@quilt/api": "workspace:*",
        "@quilt/auth": "workspace:*",
        "@quilt/db": "workspace:*",
        "@quilt/storage": "workspace:*",
        "better-auth": "1.7.12",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "varlock": "1.23.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@quilt/config": "workspace:*",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.4.1",
        "tsdown": "^0.23.0",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2"
    }
}
