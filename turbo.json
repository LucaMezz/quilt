{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "test:integration": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "test:e2e": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "e2e#test:e2e": {
            "cache": false,
            "passThroughEnv": ["HOME", "KUBECONFIG", "E2E_*"]
        },
        "check-types": {
            "dependsOn": ["^check-types"],
            "outputs": ["dist/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "generate:openapi": {
            "inputs": ["src/**", "scripts/**"],
            "outputs": ["openapi.json"]
        },
        "docs#generate:cli": {
            "inputs": [
                "scripts/generate-cli-docs.mts",
                "$TURBO_ROOT$/apps/cli/src/**",
                "$TURBO_ROOT$/apps/cli/package.json"
            ],
            "outputs": ["content/docs/cli/**"]
        },
        "docs#build": {
            "dependsOn": [
                "^build",
                "@quilt/api#generate:openapi",
                "generate:cli"
            ],
            "outputs": [".next/**", "!.next/cache/**"]
        },
        "docs#dev": {
            "dependsOn": ["@quilt/api#generate:openapi", "generate:cli"],
            "cache": false,
            "persistent": true
        },
        "db:push": {
            "cache": false,
            "interactive": true
        },
        "db:generate": {
            "cache": false,
            "interactive": true
        },
        "db:migrate": {
            "cache": false,
            "interactive": true
        },
        "db:studio": {
            "cache": false,
            "persistent": true
        },
        "db:start": {
            "cache": false
        },
        "db:stop": {
            "cache": false
        },
        "db:watch": {
            "cache": false,
            "persistent": true
        },
        "db:down": {
            "cache": false
        }
    },
    "globalEnv": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CI",
        "CORS_ORIGIN",
        "DATABASE_URL",
        "KUBECONFIG",
        "NODE_ENV",
        "RECONCILE_INTERVAL_MS",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_URL",
        "VITE_SERVER_URL",
        "_VARLOCK_ENV_KEY"
    ],
    "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
