{
    "name": "web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "tsc -b ../../packages/api && vite build",
        "serve": "vite preview",
        "start": "vite",
        "check-types": "tsc -b ../../packages/api && vite build && tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:browser": "playwright test",
        "test:browser:ui": "playwright test --ui",
        "env:generate": "varlock codegen",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@better-auth/api-key": "1.7.14",
        "@orpc/client": "^1.16.1",
        "@orpc/tanstack-query": "^1.16.1",
        "@quilt/api": "workspace:*",
        "@quilt/auth": "workspace:*",
        "@quilt/ui": "workspace:*",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.105.0",
        "@tanstack/react-router": "^1.170.46",
        "@varlock/vite-integration": "1.5.4",
        "better-auth": "1.7.14",
        "lucide-react": "^1.61.0",
        "motion": "^14.6.0",
        "next-themes": "^0.4.6",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "sonner": "^2.0.8",
        "varlock": "1.23.0",
        "zod": "^4.5.4"
