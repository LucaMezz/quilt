// Writes one MDX page per CLI command into content/docs/cli, straight from the
// command definitions (the same data `quilt --help` uses), so the reference
// can't drift from the CLI. Runs before the docs dev and build tasks.
import { mkdir, rm, writeFile } from "node:fs/promises";
import { join } from "node:path";
import {
    type ArgInfo,
    type CommandInfo,
    describeCommand,
    usageLine,
} from "cli/command-tree";
import { main } from "cli/main";

const outDir = new URL("../content/docs/cli/", import.meta.url).pathname;

const root = await describeCommand(main);

await rm(outDir, { recursive: true, force: true });
await writeCommand(root, outDir, true);
console.log(`Wrote CLI reference to ${outDir}`);

/**
 * Commands with subcommands become a folder (index page plus a page per child);
 * leaf commands become a single page.
 */
async function writeCommand(info: CommandInfo, dir: string, isRoot = false) {
    const name = info.path.at(-1) ?? "";
    const hasChildren = info.subCommands.length > 0;

    if (!hasChildren) {
        await writeFile(join(dir, `${name}.mdx`), renderPage(info));
        return;
    }

    const folder = isRoot ? dir : join(dir, name);
    await mkdir(folder, { recursive: true });
    await writeFile(join(folder, "index.mdx"), renderPage(info));
    await writeFile(
        join(folder, "meta.json"),
        `${JSON.stringify(
            {
                title: isRoot ? "CLI" : name,
                pages: [
                    "index",
                    ...info.subCommands.map((sub) => sub.path.at(-1)),
                ],
            },
            null,
            4,
        )}\n`,
    );
    for (const sub of info.subCommands) {
        await writeCommand(sub, folder);
    }
}

function renderPage(info: CommandInfo) {
    const out = [
        "---",
        `title: ${yamlString(info.path.join(" "))}`,
        ...(info.description
            ? [`description: ${yamlString(info.description)}`]
            : []),
        "---",
        "",
        "{/* Generated by apps/docs/scripts/generate-cli-docs.mts. Do not edit. */}",
        "",
        "## Usage",
        "",
        "```sh",
        usageLine(info),
        "```",
    ];

    if (info.subCommands.length > 0) {
        out.push(
            "",
            "## Commands",
            "",
            "| Command | Description |",
            "| --- | --- |",
            ...info.subCommands.map((sub) => {
                const name = sub.path.at(-1) ?? "";
                // File links: the docs site's link component maps these to page URLs.
                const href =
                    sub.subCommands.length > 0
                        ? `./${name}/index.mdx`
                        : `./${name}.mdx`;
                return `| [\`${name}\`](${href}) | ${cell(sub.description)} |`;
            }),
        );
    }

    if (info.positionals.length > 0) {
        out.push("", "## Arguments", "", ...argTable(info.positionals));
    }

    out.push("", "## Options", "", ...argTable(info.options), "");
    return out.join("\n");
}

function argTable(args: ArgInfo[]) {
    return [
        "| Name | Description | Default |",
        "| --- | --- | --- |",
        ...args.map((arg) => {
            const description = [
                sentence(arg.description),
                arg.required ? "Required." : "",
                arg.choices
                    ? `One of ${arg.choices.map((c) => `\`${c}\``).join(", ")}.`
                    : "",
            ]
                .filter(Boolean)
                .join(" ");
            const defaultValue =
                arg.default === undefined ? "" : `\`${arg.default}\``;
            return `| \`${arg.flag}\` | ${cell(description)} | ${defaultValue} |`;
        }),
    ];
}

/** Escapes text for a Markdown table cell inside MDX. */
function cell(text = "") {
    return text
        .replaceAll("|", "\\|")
        .replaceAll("{", "&#123;")
        .replaceAll("}", "&#125;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;");
}

/** Adds a full stop so extra notes like "Required." read as separate sentences. */
function sentence(text = "") {
    return text && !/[.!?]$/.test(text) ? `${text}.` : text;
}

function yamlString(text: string) {
    return JSON.stringify(text);
}
