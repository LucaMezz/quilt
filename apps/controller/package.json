{
    "name": "controller",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "exports": {
        "./controller": "./src/controller.ts"
    },
    "scripts": {
        "build": "tsc -b ../../packages/db ../../packages/cluster && tsdown",
        "check-types": "tsc -b ../../packages/db ../../packages/cluster && tsc --noEmit",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.mjs",
        "test": "vitest run --passWithNoTests",
        "env:generate": "varlock codegen"
    },
    "dependencies": {
        "@quilt/cluster": "workspace:*",
        "@quilt/db": "workspace:*",
        "drizzle-orm": "1.0.0-rc.5",
        "varlock": "1.23.0"
    },
    "devDependencies": {
        "@quilt/config": "workspace:*",
        "@types/node": "^26.4.1",
        "tsdown": "^0.23.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}
