{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": ["coverage/unit/**"]
        },
        "test:integration": {
            "dependsOn": ["^build"],
            "cache": false,
            "outputs": ["coverage/integration/**"]
        },
        "test:browser": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "test:storybook": {
            "dependsOn": ["^build"]
        },
        "test:e2e": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "e2e#test:e2e": {
            "cache": false,
            "passThroughEnv": ["HOME", "KUBECONFIG", "E2E_*"]
        },
        "check-types": {
            "dependsOn": ["^check-types"],
            "outputs": ["dist/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "@quilt/api#test:fuzz": {
            "dependsOn": ["generate:openapi"],
            "cache": false,
            "passThroughEnv": ["QUILT_API_KEY"]
        },
        "generate:openapi": {
            "inputs": ["src/**", "scripts/**"],
            "outputs": ["openapi.json"]
        },
        "docs#generate:cli": {
            "inputs": [
                "scripts/generate-cli-docs.mts",
                "$TURBO_ROOT$/apps/cli/src/**",
                "$TURBO_ROOT$/apps/cli/package.json"
            ],
            "outputs": ["content/docs/cli/**"]
        },
        "docs#build": {
            "dependsOn": [
                "^build",
                "@quilt/api#generate:openapi",
                "generate:cli",
                "check-types"
            ],
            "outputs": [".next/**", "!.next/cache/**"]
        },
        "docs#dev": {
            "dependsOn": ["@quilt/api#generate:openapi", "generate:cli"],
            "cache": false,
            "persistent": true
        },
        "db:push": {
            "cache": false,
            "interactive": true
        },
        "db:generate": {
            "cache": false,
            "interactive": true
        },
        "db:migrate": {
            "cache": false,
            "interactive": true
        },
        "db:studio": {
            "cache": false,
            "persistent": true
        }
    },
    "remoteCache": {
        "signature": true
    },
    "globalEnv": ["NODE_ENV"],
    "globalPassThroughEnv": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CI",
        "CORS_ORIGIN",
        "DATABASE_URL",
        "KUBECONFIG",
        "RECONCILE_INTERVAL_MS",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_BUCKET",
        "STORAGE_ENDPOINT",
        "STORAGE_FORCE_PATH_STYLE",
        "STORAGE_REGION",
        "STORAGE_SECRET_ACCESS_KEY",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_URL",
        "VITE_SERVER_URL",
        "_VARLOCK_ENV_KEY"
    ]
}
